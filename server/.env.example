# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# For local development, replace with your local PostgreSQL URI
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/publishflow_ai?schema=public"

# Authentication
# Run `openssl rand -base64 32` or use a secure random string for production
JWT_SECRET="super-secret-dev-jwt-token-key-change-in-production"
