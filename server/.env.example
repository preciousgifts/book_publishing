# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (Required for CORS in production)
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL / Supabase / Neon)
# Direct connection or connection pooler URI
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/publishflow_db?schema=public"

# Python AI Swarm Worker Service URL
PYTHON_WORKER_URL=http://localhost:8000
FASTAPI_URL=http://localhost:8000

# Authentication JWT Secret
# Run `openssl rand -base64 32` to generate a secure secret for production
JWT_SECRET="super-secret-dev-jwt-token-key-change-in-production"

