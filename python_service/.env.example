# Server Configuration
PORT=8000
HOST=127.0.0.1

# Active LLM Provider Selection
# Options: gemini | openai | anthropic | groq | kimi
ACTIVE_LLM_PROVIDER="gemini"

# Google Gemini Configuration
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MAX_REMOTE_CALLS=10
GEMINI_DISABLE_AFC=false

# OpenAI Configuration
OPENAI_API_KEY=""

# Anthropic / Claude Configuration (or AgentRouter compatible gateway)
ANTHROPIC_API_KEY=""
ANTHROPIC_AUTH_TOKEN=""
ANTHROPIC_BASE_URL="https://agentrouter.org"
ANTHROPIC_MODEL=""

# Groq Configuration (Llama 3.3 70B)
GROQ_API_KEY=""

# Kimi / Moonshot Configuration
KIMI_API_KEY=""

# Pipeline Configurations
RESEARCH_TITLE_SUGGESTIONS_COUNT=6

