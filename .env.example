# ==============================================================================
# PublishFlow AI: Master Environment Configuration Template
# Copy this file to each service folder (.env) and configure appropriate values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE.JS GATEWAY SERVER CONFIGURATIONS (server/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
JWT_SECRET=super-secret-dev-jwt-token-key-change-in-production

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/publishflow_db?schema=public"

# URL of the Python worker service
PYTHON_WORKER_URL=http://localhost:8000
# URL of the Frontend client
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. PYTHON AI WORKER CONFIGURATIONS (python_service/.env)
# ------------------------------------------------------------------------------
PORT=8000
HOST=127.0.0.1

# Multi-Provider LLM Setup
ACTIVE_LLM_PROVIDER="gemini" # Options: gemini, kimi, openai, anthropic, groq

# LLM Provider API Keys
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
KIMI_API_KEY="sk-YourKimiApiKeyHere"       # Moonshot / Kimchi API
OPENAI_API_KEY="sk-proj-YourOpenAIApiKeyHere"
ANTHROPIC_API_KEY="sk-ant-YourAnthropicApiKeyHere"
GROQ_API_KEY="gsk_YourGroqApiKeyHere"

# ------------------------------------------------------------------------------
# 3. REACT FRONTEND APP CONFIGURATIONS (frontend/.env)
# ------------------------------------------------------------------------------
# Dev API URL pointing to the Node.js Express Gateway
VITE_API_URL=http://localhost:5000/api
